[Unit]
Description=Quiz Zone FastAPI app
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/quiz-zone/backend
EnvironmentFile=/home/ubuntu/quiz-zone/.env
ExecStart=/home/ubuntu/quiz-zone/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
