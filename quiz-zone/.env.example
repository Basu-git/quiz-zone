# Copy this file to .env and fill in your real values. NEVER commit .env to GitHub.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (works over IPv4, needed for EC2)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Comma-separated allowed origins. "*" is fine for a demo.
CORS_ORIGINS=*
